# Copy to .env and fill in. Never commit .env.

# Agent token from Slates (Agents -> Connect). Use a token made for this runner.
SLATES_TOKEN=slt_xxx

# Name tasks are addressed to on the Slates desk (handoffs "to": "Claude").
AGENT_NAME=Claude

# How often to check the desk, in seconds.
POLL_SECONDS=60

# Tools Claude may use without asking, space-separated.
# Default is Slates only. To let it work on files in its task folder, add e.g.:
#   ALLOWED_TOOLS=mcp__slates__* Read Edit Write Glob Grep
ALLOWED_TOOLS=mcp__slates__*

# Per-task limits.
MAX_BUDGET_USD=2
TASK_TIMEOUT_MIN=30

# Optional: CLAUDE_MODEL=opus

# How many agent runs may happen at the same time (across all agents).
MAX_CONCURRENT=2

# --- Several agents (optional) ---
# Each agent needs its own Slates token (one token = one agent identity).
# Copy agents.example.json to agents.json, then:
# AGENTS_FILE=agents.json
# SLATES_TOKEN_CLAUDE=slt_xxx
# SLATES_TOKEN_CODEX=slt_yyy

# --- Telegram front door (optional) ---
# Create a bot with @BotFather and paste its token. Leave TELEGRAM_ALLOWED_CHAT_IDS empty at first:
# message your bot and it replies with your chat id. Put that id here (comma-separated for several).
# Only these chats can give your agents tasks.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_ALLOWED_CHAT_IDS=
# Which agent gets Telegram tasks (default: the first agent).
# TELEGRAM_TO_AGENT=Claude
# Optional separate Slates token so Telegram tasks show as coming from "Telegram":
# SLATES_TOKEN_TELEGRAM=slt_zzz
# Approvals: with Telegram set up, Claude gets a request_approval tool that sends you Yes/No buttons
# before risky steps. No tap within the timeout counts as No. APPROVALS=false turns it off.
# APPROVAL_TIMEOUT_SEC=600

# --- Phone calls (needs Telegram approvals above) ---
# Every call needs your Yes on Telegram. "simulated" plays a scripted call (never dials); "agora" is not wired yet.
# CALL_PROVIDER=simulated
# OWNER_NAME=Gajanan              # said in every call: "an AI assistant calling on behalf of ..."
# CALL_MAX_PER_TASK=3
# CALL_MAX_MINUTES=5
# CALL_QUIET_HOURS=21-9           # no calls from 21:00 to 09:00
# CALL_TIMEZONE=Asia/Kolkata
# CALL_ALLOWED_PREFIXES=+91       # optional: only these country codes

# GROUP_MAX_PEOPLE=8   # most people one coordinate_group may call

# --- Agents at work board ---
# The runner keeps one pinned table board in Slates ("Agents at work", slug agents-at-work) showing every
# agent's current task, status and result. Times use CALL_TIMEZONE (default Asia/Kolkata). Set to false to turn it off.
# WORK_BOARD=true

# --- Browser for Claude (optional) ---
# BROWSER_TOOLS=1 gives Claude a real headless browser via Microsoft's Playwright MCP server
# (npx -y @playwright/mcp@0.0.86 --headless --isolated; version pinned in lib.mjs) and allows mcp__playwright__*.
# Claude is told to call request_approval before submitting anything that spends money, books, signs up or sends messages,
# so turn on Telegram approvals too. On a Mac it uses your installed Google Chrome. On Linux/Docker ARM64 install
# Chromium (see Dockerfile) and set BROWSER_NAME=chromium.
# BROWSER_TOOLS=1
# BROWSER_NAME=chromium

# --- Live "ask an agent" in voice calls (POST {PUBLIC_BASE_URL}/ask) ---
# Agora's voice agent calls /ask with "Authorization: Bearer $ASK_SECRET"; the same secret signs the call ctx.
# Claude is always available; Codex if `codex` is installed and signed in (`codex login`); Antigravity if `agy` exists.
# Cheapest models by default (live asks only; desk tasks keep CLAUDE_MODEL):
# ASK_SECRET=long-random-string
# CLAUDE_ASK_MODEL=claude-haiku-5-5
# CODEX_MODEL=gpt-6-luna
# CODEX_ASK_EFFORT=low
# AGY_MODEL=gemini-3.8-flash-low
# CODEX_BIN=codex   AGY_BIN=~/.local/bin/agy   (optional, found on PATH / ~/.local/bin otherwise)

# --- Meeting room (POST /room/event, /room/hush, GET /room/state; same ASK_SECRET) ---
# Live agents hear the shared transcript, take the floor (interrupting whoever is speaking), and the owner's
# barge-in stops everyone. After each turn a cheap Gemini call (needs GEMINI_API_KEY) may let one other agent
# jump in; at most 2 agent turns in a row, never the same agent twice. Without GEMINI_API_KEY nobody jumps in.
# ROOM_JUMP_IN=false            # turn jump-ins off
# ROOM_JUMP_AFTER_HOST=false    # only after agents' turns, not after Slates' own answers
# MODERATOR_MODEL=gemini-3.5-flash-lite
# MODERATOR_TIMEOUT_MS=3000
